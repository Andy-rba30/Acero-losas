<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>ARBA Losas</Name>
    <Assembly>SlabRebar\SlabRebar.dll</Assembly>
    <FullClassName>SlabRebar.RibbonApp</FullClassName>
    <ClientId>c3e7a9d2-5b14-4f8e-9a6b-7d2e0f1c4a58</ClientId>
