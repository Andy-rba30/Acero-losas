<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programa de consola que prueba las clases puras (sin Revit): Geometry2D, SlabPlan, AppConfig y, del codigo comun
       ARBA-comun (submodulo external/ARBA-comun), ArbaContract, ArbaPartition, PartitionName y NameMatch.
       dotnet run -c Debug (desde esta carpeta). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SlabRebar.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Geometry2D.cs" Link="Geometry2D.cs" />
    <Compile Include="..\SlabPlan.cs" Link="SlabPlan.cs" />
    <Compile Include="..\AppConfig.cs" Link="AppConfig.cs" />
    <!-- Archivos puros del comun (sin Revit); los demas de src/ dependen de la API de Revit y no entran aqui -->
    <Compile Include="..\external\ARBA-comun\src\ArbaContract.cs" Link="Arba.Comun\ArbaContract.cs" />
    <Compile Include="..\external\ARBA-comun\src\ArbaPartition.cs" Link="Arba.Comun\ArbaPartition.cs" />
    <Compile Include="..\external\ARBA-comun\src\PartitionName.cs" Link="Arba.Comun\PartitionName.cs" />
    <Compile Include="..\external\ARBA-comun\src\NameMatch.cs" Link="Arba.Comun\NameMatch.cs" />
  </ItemGroup>

</Project>
